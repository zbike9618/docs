# /etc/site-build.env — ビルダー（build.sh）の設定。マシンごとに違うところだけ書く。
# 本番（CT111）の例。staging は BRANCH と VITE_API_URL を変える（README 参照）。

# ソースの取得元とブランチ（public なので認証なし）
REPO_URL=https://github.com/zbike9618/docs.git
BRANCH=main

# ビルド中に API を読みに行く先（同じマシンの gozakura-api）
BUILD_API_URL=http://127.0.0.1:3000

# ブラウザが API を呼ぶ先と、記事内の画像（/uploads/...）の URL に使う値。
# 空なら https://api.gozakura.org（本番はこれでよい）。staging は http://192.168.11.113 のように自分を指す
VITE_API_URL=

# 置き場所
WORK_DIR=/opt/site-build
OUT_DIR=/var/www/site
STATE_DIR=/var/lib/site-build

# 古い公開版を何個残すか（ロールバック用）
KEEP_RELEASES=5

# 保存から何秒待って1回にまとめるか / 失敗後に自動で再挑戦するまで / 強制ビルドの間隔（秒）
DEBOUNCE_SEC=30
RETRY_AFTER_FAIL_SEC=300
FORCE_EVERY_SEC=86400

# Node のメモリ上限（MB）。CT111 は 1GB なので控えめにしてある
NODE_OPTIONS=--max-old-space-size=512

# npm ci に足す引数（例: --ignore-scripts）。通常は空
NPM_CI_ARGS=
